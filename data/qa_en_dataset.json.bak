        },
        
        {
          "question": "What are the key principles of GDPR?",
          "answer": "The key principles are lawfulness, fairness and transparency; purpose limitation; data minimization; accuracy; storage limitation; integrity and confidentiality; and accountability"
        },
        {
          "question": "What is the role of a Data Protection Officer (DPO)?",
          "answer": "A DPO advises on compliance obligations, monitors compliance, provides advice on data protection impact assessments, cooperates with supervisory authorities, and acts as a contact point for data subjects and authorities"
        },
        {
          "question": "What are special categories of data under GDPR?",
          "answer": "Special categories include racial or ethnic origin, political opinions, religious or philosophical beliefs, trade union membership, genetic data, biometric data, health data, and data concerning sexual orientation"
        },
        {
          "question": "What is a cross-border processing under GDPR?",
          "answer": "Cross-border processing involves either processing in multiple EU establishments of a controller/processor or processing in a single EU establishment that substantially affects data subjects in multiple member states"
        },
        {
          "question": "What is the one-stop-shop mechanism?",
          "answer": "The one-stop-shop mechanism allows organizations operating in multiple EU countries to deal primarily with a single lead supervisory authority in the country of their main establishment"
        },
        {
          "question": "What are binding corporate rules in the context of GDPR?",
          "answer": "Binding corporate rules are data protection policies adhered to by a controller or processor for transfers of personal data outside the EU within a group of undertakings or enterprises"
        },
        {
          "question": "What is a joint controller relationship?",
          "answer": "Joint controllers exist when two or more controllers jointly determine the purposes and means of processing, requiring a transparent arrangement that defines their respective responsibilities for compliance"
        },
        {
          "question": "What is privacy by default?",
          "answer": "Privacy by default means that, by default, only personal data necessary for each specific purpose should be processed, applying to amount collected, extent of processing, storage period, and accessibility"
        },
        {
          "question": "What is the European Data Protection Board (EDPB)?",
          "answer": "The EDPB is an independent European body that contributes to consistent application of data protection rules, provides guidance, promotes cooperation between supervisory authorities, and issues binding decisions in certain cross-border cases"
        },
        {
          "question": "What is the difference between a data controller and a data processor?",
          "answer": "A data controller determines the purposes and means of processing personal data, while a data processor processes personal data on behalf of the controller"
        },
        {
          "question": "What is the right to data portability?",
          "answer": "The right to data portability allows individuals to obtain and reuse their personal data across different services by receiving it in a structured, commonly used, machine-readable format"
        },
        {
          "question": "What is a data breach notification?",
