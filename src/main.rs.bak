mod nabla;
mod tokenizer;
mod embedding;
mod attention;
mod training;
mod export;

use ndarray::{Array, Array3};
use nabla::tensor::Tensor;
use tokenizer::{Tokenizer, basic_tokenizer::BasicTokenizer};
use embedding::TransformerEmbedding;
use attention::{Attention, SelfAttention, MultiHeadAttention, FeedForward};
use training::Trainer;
use std::env;
use rayon::prelude::*;
use ndarray_rand::RandomExt;
use ndarray_rand::rand_distr::{Uniform, Normal};
use std::path::{Path, PathBuf};

/// Funzione principale
fn main() {
    // Configura il numero di thread per rayon
    let num_cpus = num_cpus::get();
    rayon::ThreadPoolBuilder::new().num_threads(num_cpus).build_global().unwrap();
    println!("Hi Wall-e!");
    println!("Utilizzo di {} CPU per il calcolo parallelo", num_cpus);
    
    // Argomenti da riga di comando
    let args: Vec<String> = env::args().collect();
    
    // Gestione dell'esportazione del modello
    if args.len() > 1 && args[1] == "--export-model" {
        if args.len() < 3 {
            eprintln!("Errore: Manca il percorso del modello da esportare");
            eprintln!("Uso: cargo run -- --export-model path/to/model.bin");
            std::process::exit(1);
        }
        
        let model_path = &args[2];
        
        println!("Caricamento del modello da '{}'...", model_path);
        
        // Crea un tokenizer base
        let tokenizer = Box::new(tokenizer::basic_tokenizer::BasicTokenizer::new());
        
        // Carica il modello
        match training::Trainer::load_model(model_path, tokenizer, Some(0.0005)) {
            Ok(trainer) => {
                // Determina il percorso di output preservando il nome file originale
                let file_name = Path::new(model_path).file_stem()
                    .and_then(|s| s.to_str())
                    .unwrap_or("model");
                
                let output_path = format!("models/{}.bin", file_name);
                
                println!("Esportazione del modello in formato binario su '{}'...", output_path);
                if let Err(e) = trainer.save_model(&output_path) {
                    eprintln!("Errore durante il salvataggio: {}", e);
                    std::process::exit(1);
                }
                
                println!("Esportazione completata con successo!");
                println!("Per verificare il modello: cargo run -- --verify-model {}", output_path);
            },
            Err(e) => {
                eprintln!("Errore durante il caricamento del modello: {}", e);
                std::process::exit(1);
            }
        }
        
        std::process::exit(0);
    }
    
    // Verifica di un modello
    if args.len() > 1 && args[1] == "--verify-model" {
        if args.len() < 3 {
            eprintln!("Errore: Manca il percorso del modello da verificare");
            eprintln!("Uso: cargo run -- --verify-model path/to/model.bin");
            std::process::exit(1);
        }
        
        let model_path = &args[2];
        
        println!("Verifica del modello '{}'...", model_path);
        match export::verify_model(model_path) {
            Ok(_) => {
                println!("Il modello è valido!");
                std::process::exit(0);
            },
            Err(e) => {
                eprintln!("Errore nella verifica del modello: {}", e);
                std::process::exit(1);
            }
        }
    }
    
    // Test salvataggio e caricamento modello
    if args.len() > 1 && args[1] == "--test-model-io" {
        println!("Test di salvataggio e caricamento modello...");
        
        // Crea un tokenizer
        let tokenizer = Box::new(crate::tokenizer::basic_tokenizer::BasicTokenizer::new());
        
        // Crea un trainer con un modello piccolo
        let trainer = crate::training::Trainer::new(
            tokenizer,
            96,  // model_dim
            192, // ff_dim
            6,   // num_heads
            3,   // num_layers
            0.1, // dropout_rate
            0.0005 // learning_rate
        );
        
        // Salva il modello
        let model_path = "models/test_model.bin";
        println!("Salvataggio del modello in '{}'...", model_path);
        
        if let Err(e) = trainer.save_model(model_path) {
            eprintln!("Errore durante il salvataggio del modello: {}", e);
            std::process::exit(1);
        }
        
        // Verifica il modello
        println!("Verifica del modello salvato...");
        if let Err(e) = export::verify_model(model_path) {
            eprintln!("Errore nella verifica del modello: {}", e);
            std::process::exit(1);
        }
        
        // Carica il modello
        println!("Caricamento del modello da '{}'...", model_path);
        let tokenizer = Box::new(crate::tokenizer::basic_tokenizer::BasicTokenizer::new());
        
        match Trainer::load_model(model_path, tokenizer, Some(0.0005)) {
            Ok(_) => {
                println!("Modello caricato con successo!");
                println!("Test completato con successo!");
            },
            Err(e) => {
                eprintln!("Errore durante il caricamento del modello: {}", e);
                std::process::exit(1);
            }
        }
        
        std::process::exit(0);
    }
    
    // Se non sono stati specificati comandi specifici, mostra l'help
    if args.len() <= 1 || args[1].starts_with("-h") || args[1].starts_with("--help") {
        println!("Uso: cargo run -- [COMANDO] [OPZIONI]");
        println!("");
        println!("Comandi disponibili:");
        println!("  --export-model PATH       Esporta un modello in formato binario");
        println!("  --verify-model PATH       Verifica che un modello sia valido");
        println!("  --test-model-io           Esegue un test di salvataggio e caricamento");
        println!("");
        println!("Esempi:");
        println!("  cargo run -- --export-model models/existing_model.bin");
        println!("  cargo run -- --verify-model models/model.bin");
        println!("  cargo run -- --test-model-io");
        std::process::exit(0);
    }
    
    eprintln!("Comando non riconosciuto: {}", args[1]);
    eprintln!("Usa 'cargo run -- --help' per visualizzare i comandi disponibili");
    std::process::exit(1);
}

